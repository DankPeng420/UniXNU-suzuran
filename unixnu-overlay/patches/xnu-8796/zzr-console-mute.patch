 vcputc_options(char c, __unused bool poll)
 {
+	if (native_console_line_start && c != '\n') {
+		native_console_ring_stamp();
+	}
+	native_console_line_start = (c == '\n');
+	native_console_ring_put(c);
+
+	if (native_console_muted && kernel_debugger_entry_count == 0) {
+		return;
+	}
