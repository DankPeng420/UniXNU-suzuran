+/*
+ * AppleKeyStore stand-in: upstream's NativeKeyStoreEvents (force-loaded archive) answers the state
+ * queries of libaks/MobileKeyBag for a device with no SEP, no keybag and no passcode, so keybagd --init
+ * gets its system bag handle instead of rebooting into recovery. These are the hooks it calls; the
+ * service is enabled whenever it is linked (it protects nothing, see its source).
+ */
+#include <security/mac_policy.h>
+#include <sys/proc.h>
+
+static uint64_t native_aks_seen[4];
+
+void
+native_keyevents_open_refused(void)
+{
+	IOLog("NativeAKS: user client refused\n");
+}
+
+bool
+native_aks_state_enabled(void)
+{
+	return true;
+}
+
+uint32_t
+native_aks_lock_state(void)
+{
+	return 0;       /* sls: unlocked */
+}
+
+void
+native_aks_opened(void)
+{
+	static bool once;
+	if (!once) {
+		once = true;
+		IOLog("NativeAKS: first user client opened\n");
 	}
 }
