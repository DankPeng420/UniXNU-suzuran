+/* One console line per selector the first time it is used: the next unsupported one names itself. */
+void
+native_aks_call(uint32_t selector, int32_t result)
+{
+	if (selector >= 256) {
+		IOLog("NativeAKS: sel %u -> 0x%x\n", selector, (uint32_t)result);
+		return;
+	}
+	const uint64_t bit = 1ULL << (selector % 64);
+	if (native_aks_seen[selector / 64] & bit) {
+		return;
+	}
+	native_aks_seen[selector / 64] |= bit;
+	IOLog("NativeAKS: sel %u -> 0x%x\n", selector, (uint32_t)result);
+}
+
+/* Personality on IOResources for a force-loaded stand-in class, if it is linked. */
+static void
+native_resource_publish(const char *className)
+{
+	const OSSymbol *name = OSSymbol::withCString(className);
+	if (name == NULL) {
+		return;
+	}
+	if (OSMetaClass::getMetaClassWithName(name) == NULL) {
+		name->release();
+		return;
+	}
+	OSDictionary *personality = OSDictionary::withCapacity(4);
+	OSArray *drivers = OSArray::withCapacity(1);
+	const OSSymbol *provider = OSSymbol::withCString("IOResources");
+	OSString *resource = OSString::withCString("IOKit");
+	if (personality && drivers && provider && resource) {
+		personality->setObject(gIOClassKey, name);
+		personality->setObject(gIOProviderClassKey, provider);
+		personality->setObject(gIOResourceMatchKey, resource);
+		personality->setObject(gIOMatchCategoryKey, name);
+		drivers->setObject(personality);
+		IOLog("native: %s personality %s\n", className,
+		    gIOCatalogue->addDrivers(drivers, true) ? "published" : "REFUSED");
+	}
+	OSSafeReleaseNULL(personality);
+	OSSafeReleaseNULL(drivers);
+	OSSafeReleaseNULL(provider);
+	OSSafeReleaseNULL(resource);
+	name->release();
+}
+
+/* Personality for a force-loaded class that matches an /arm-io nub by its compatible string. */
+static void
+native_device_publish(const char *className, const char *compatible)
+{
+	const OSSymbol *name = OSSymbol::withCString(className);
+	if (name == NULL) {
+		return;
+	}
+	if (OSMetaClass::getMetaClassWithName(name) == NULL) {
+		name->release();
+		return;
+	}
+	OSDictionary *personality = OSDictionary::withCapacity(4);
+	OSArray *drivers = OSArray::withCapacity(1);
+	const OSSymbol *provider = OSSymbol::withCString("IOPlatformDevice");
+	OSString *match = OSString::withCString(compatible);
+	if (personality && drivers && provider && match) {
+		personality->setObject(gIOClassKey, name);
+		personality->setObject(gIOProviderClassKey, provider);
+		personality->setObject(gIONameMatchKey, match);
+		drivers->setObject(personality);
+		IOLog("native: %s personality %s\n", className,
+		    gIOCatalogue->addDrivers(drivers, true) ? "published" : "REFUSED");
+	}
+	OSSafeReleaseNULL(personality);
+	OSSafeReleaseNULL(drivers);
+	OSSafeReleaseNULL(provider);
+	OSSafeReleaseNULL(match);
+	name->release();
+}
