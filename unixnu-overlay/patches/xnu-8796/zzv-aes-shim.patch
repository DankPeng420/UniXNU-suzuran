+/*
+ * Permissive "Sandbox" MAC policy: libsystem_sandbox calls __mac_syscall("Sandbox", op, arg), and with
+ * no policy of that name every call fails with ENOPOLICY, so launchd answers mach lookups with
+ * "error = 159: Sandbox restriction" (backboardd cannot reach mobilegestalt or iohideventsystem) and
+ * tccd exits "profile not found". This phone runs without a sandbox (Apple's Sandbox kext is not
+ * loaded): operations succeed, and the few that must return data (container paths, extension
+ * tokens) fail with ENOENT. Behaviour established on hardware by ios-sweet (patch 0050). The first
+ * use of each operation is logged.
+ */
+static uint64_t native_sandbox_seen[2];
+static struct mac_policy_ops native_sandbox_ops;
+static struct mac_policy_conf native_sandbox_conf;
+static mac_policy_handle_t native_sandbox_handle;
+
+static int
+native_sandbox_syscall(struct proc *, int call, user_addr_t)
+{
+	if (call >= 0 && call < 128 && !(native_sandbox_seen[call / 64] & (1ULL << (call % 64)))) {
+		native_sandbox_seen[call / 64] |= 1ULL << (call % 64);
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("NativeSandbox: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 4:         /* container path (audit token / pid) */
+	case 5:         /* extension issue */
+	case 6:         /* extension consume */
+	case 0x43:      /* container expected */
+		return ENOENT;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * Called from kernel_bootstrap_thread before machine_lockdown: mac_policy_list is read-only late,
+ * so a policy registered after lockdown faults ("Unexpected fault in kernel static region").
+ */
+void
+native_sandbox_register(void)
+{
+	native_sandbox_ops.mpo_policy_syscall = native_sandbox_syscall;
+	native_sandbox_conf.mpc_name = "Sandbox";
+	native_sandbox_conf.mpc_fullname = "Lumia permissive sandbox stand-in";
+	native_sandbox_conf.mpc_ops = &native_sandbox_ops;
+	int error = mac_policy_register(&native_sandbox_conf, &native_sandbox_handle, NULL);
+	IOLog("NativeSandbox: permissive policy %s (%d)\n", error ? "NOT registered" : "registered", error);
+}
+
+/*
+ * AppleKeyStore (NativeKeyStoreEvents), IOWatchdog (NativeWatchdog), touch and side keys (NativeTouch), the CPU clock
+ * readout (NativeCpuClock), the battery (NativeBattery) and the display (NativeDisplay):
+ * IOSurface's IOCoreSurfaceRoot on IOResources, AppleCLCD on the /arm-io/disp0 nub.
+ */
+void
+native_keystore_publish(void)
+{
+	native_resource_publish("AppleKeyStore");
+	native_resource_publish("IOWatchdog");
+	native_resource_publish("IOCoreSurfaceRoot");
+	native_resource_publish("NativeTouch");
+	native_resource_publish("NativeHIDTouch");
+	native_resource_publish("NativeHIDButtons");
+	native_resource_publish("NativeCpuClock");
+	native_resource_publish("NativeBattery");
+	native_resource_publish("NativeAdreno430");
+	native_device_publish("AppleCLCD", "lumia950,display");
+}
