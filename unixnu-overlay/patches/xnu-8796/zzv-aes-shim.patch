+/*
+ * procmon companion: one line per IOMedia (whole disks with their size, partitions by BSD name and
+ * content hint) plus the IONVRAM resource, so storage bring-up survives the console scroll.
+ */
+extern volatile uint64_t native_sdhci_bytes __attribute__((weak));
+extern volatile uint64_t native_sdhci_reads __attribute__((weak));
+extern volatile uint64_t native_sdhci_writes __attribute__((weak));
+extern volatile uint64_t cs_native4k_bytes __attribute__((weak));
+extern volatile uint64_t cs_native4k_ready_blobs __attribute__((weak));
+extern volatile uint64_t cs_native4k_read_ticks __attribute__((weak));
+extern volatile uint64_t cs_native4k_hash_ticks __attribute__((weak));
+
+void
+native_media_report(void)
+{
+	OSObject *nvram = IOService::getResourceService()->getProperty("IONVRAM");
+	IOLog("procmon: IONVRAM resource %s\n", nvram ? "published" : "missing");
+	/* Storage progress: eMMC bytes moved, read requests and write bursts, and the 4K code signature
+	 * cache (bytes of 16K-signed files hashed, blobs ready, and the time in reads and in hashing,
+	 * 19.2 MHz timebase), which is what a silent boot spends minutes on while it verifies the shared
+	 * cache. */
+	IOLog("procmon: emmc %llu bytes, %llu reads, %llu writes; cs4k %llu bytes, %llu blobs, %llu ms reading, %llu ms hashing\n",
+	    &native_sdhci_bytes ? (unsigned long long)native_sdhci_bytes : 0ULL,
+	    &native_sdhci_reads ? (unsigned long long)native_sdhci_reads : 0ULL,
+	    &native_sdhci_writes ? (unsigned long long)native_sdhci_writes : 0ULL,
+	    &cs_native4k_bytes ? (unsigned long long)cs_native4k_bytes : 0ULL,
+	    &cs_native4k_ready_blobs ? (unsigned long long)cs_native4k_ready_blobs : 0ULL,
+	    &cs_native4k_read_ticks ? (unsigned long long)(cs_native4k_read_ticks / 19200) : 0ULL,
+	    &cs_native4k_hash_ticks ? (unsigned long long)(cs_native4k_hash_ticks / 19200) : 0ULL);
+	OSIterator *iterator = IOService::getMatchingServices(IOService::serviceMatching("IOMedia"));
+	if (iterator == NULL) {
+		IOLog("procmon: no IOMedia\n");
+		return;
+	}
+	unsigned count = 0;
+	while (OSObject *object = iterator->getNextObject()) {
+		IOService *media = OSDynamicCast(IOService, object);
+		if (media == NULL) {
+			continue;
+		}
+		OSString *bsd = OSDynamicCast(OSString, media->getProperty("BSD Name"));
+		OSString *hint = OSDynamicCast(OSString, media->getProperty("Content Hint"));
+		OSNumber *size = OSDynamicCast(OSNumber, media->getProperty("Size"));
+		OSBoolean *whole = OSDynamicCast(OSBoolean, media->getProperty("Whole"));
+		/* 55 partitions would flood the panel: whole disks, the iOS partition and the last one. */
+		if (whole == kOSBooleanTrue || (hint && strncmp(hint->getCStringNoCopy(), "48465300", 8) == 0)) {
+			IOLog("procmon: media %s %llu bytes%s%s%s\n", bsd ? bsd->getCStringNoCopy() : "?",
+			    size ? size->unsigned64BitValue() : 0ULL, whole == kOSBooleanTrue ? " whole" : "",
+			    hint ? " " : "", hint ? hint->getCStringNoCopy() : "");
+		}
+		count++;
+	}
+	iterator->release();
+	IOLog("procmon: %u IOMedia\n", count);
+}
