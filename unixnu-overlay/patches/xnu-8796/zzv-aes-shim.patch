+/*
+ * aesshim=1: AppleImage4 waits forever for an IOAESAccelerator before it locks the nonce hashes and
+ * opens the gate the ignition-blob sysctl waits on, so launchd stalls in dyld's ignition on a board
+ * without Apple's AES engine. The prelinked IOCryptoAcceleratorFamily's IOAESAccelerator is a concrete
+ * class; this publishes a personality that instantiates it by name on IOResources, with no link-time
+ * binding to the family's ABI. It matches on IOBSD, as upstream's NativeAES does: IOAESAccelerator::start
+ * itself waits for the IOBSD resource, and run any earlier it blocks the IOResources matching that loads
+ * APFS (the root mount then fails with ENODEV).
+ */
+void
+native_aes_shim_publish(void)
+{
+	uint32_t enable = 0;
+	if (!PE_parse_boot_argn("aesshim", &enable, sizeof(enable)) || enable == 0) {
+		return;
+	}
+	OSDictionary *personality = OSDictionary::withCapacity(5);
+	OSArray *drivers = OSArray::withCapacity(1);
+	const OSSymbol *aes = OSSymbol::withCString("IOAESAccelerator");
+	const OSSymbol *resources = OSSymbol::withCString("IOResources");
+	OSString *resource = OSString::withCString("IOBSD");
+	OSString *category = OSString::withCString("NativeAESShim");
+	OSString *bundle = OSString::withCString("com.apple.iokit.IOCryptoAcceleratorFamily");
+	if (personality && drivers && aes && resources && resource && category && bundle) {
+		personality->setObject(gIOClassKey, aes);
+		personality->setObject(gIOProviderClassKey, resources);
+		personality->setObject(gIOResourceMatchKey, resource);
+		personality->setObject(gIOMatchCategoryKey, category);
+		personality->setObject(kCFBundleIdentifierKey, bundle);
+		drivers->setObject(personality);
+		IOLog("aesshim: IOAESAccelerator personality %s\n",
+		    gIOCatalogue->addDrivers(drivers, true) ? "published" : "REFUSED");
+	}
+	OSSafeReleaseNULL(personality);
+	OSSafeReleaseNULL(drivers);
+	OSSafeReleaseNULL(aes);
+	OSSafeReleaseNULL(resources);
+	OSSafeReleaseNULL(resource);
+	OSSafeReleaseNULL(category);
+	OSSafeReleaseNULL(bundle);
+}
