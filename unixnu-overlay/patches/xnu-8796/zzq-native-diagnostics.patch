+/*
+ * launchd points the stdout and stderr of most daemons at /dev/null. What the processes named in
+ * boot-arg nativenull (comma separated, default "backboardd,SpringBoard", "-" = off) write there
+ * goes to the console, and so to the persistent console log, as "|name| text", at most 3000 writes
+ * per boot. After ios-sweet's patch 0048 (MIT).
+ */
+static char native_null_names[128];
+static int native_null_parsed;
+static uint32_t native_null_writes;
+
+static bool
+native_null_tee(char *name, size_t len)
+{
+	if (!native_null_parsed) {
+		if (!PE_parse_boot_argn("nativenull", native_null_names, sizeof(native_null_names))) {
+			strlcpy(native_null_names, "backboardd,SpringBoard", sizeof(native_null_names));
+		}
+		native_null_parsed = 1;
+	}
+	if (native_null_names[0] == '-' || native_null_writes >= 3000) {
+		return false;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = native_null_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			native_null_writes++;
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
