+/*
+ * IOKit trace: what the processes named in boot-arg nativeiolog (comma separated, default
+ * "backboardd,SpringBoard", "-" = off) look up in the registry, match, are notified about and open,
+ * as "IOK name: ..." lines, at most 600 per boot. A service a daemon waits for that no driver
+ * publishes shows up here as "0 found" / "none". After ios-sweet's patch 0049 (MIT).
+ */
+extern "C" void proc_selfname(char * buf, int size);
+static char native_iolog_names[128];
+static bool native_iolog_parsed;
+static uint32_t native_iolog_lines;
+
+static bool
+native_iolog(char *name, size_t len)
+{
+	if (!native_iolog_parsed) {
+		if (!PE_parse_boot_argn("nativeiolog", native_iolog_names, sizeof(native_iolog_names))) {
+			strlcpy(native_iolog_names, "backboardd,SpringBoard", sizeof(native_iolog_names));
+		}
+		native_iolog_parsed = true;
+	}
+	if (native_iolog_lines >= 600 || native_iolog_names[0] == '-') {
+		return false;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = native_iolog_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			native_iolog_lines++;
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+/* A matching dictionary as compact XML, at most 240 characters. */
+static void
+native_iolog_dict(const char *name, const char *what, OSObject *dict, const char *result)
+{
+	OSSerialize *ser = OSSerialize::withCapacity(256);
+	const char *text = "?";
+	if (ser != NULL && dict != NULL && dict->serialize(ser)) {
+		text = ser->text();
+	}
+	IOLog("IOK %s: %s %.240s -> %s\n", name, what, text, result);
+	OSSafeReleaseNULL(ser);
 }
 
