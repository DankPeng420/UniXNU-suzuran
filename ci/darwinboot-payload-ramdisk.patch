+  //
+  if ((Ramdisk == NULL) && (RamdiskOffset != MAX_UINTN)) {
+    CopyMem (TreePath, Request->KernelPath, Length);
+    StrCatS (TreePath, Length / sizeof (CHAR16) + 11, L".ramdisk");
+    Status = ReadFile (Root, TreePath, SIZE_256MB, &PayloadRamdisk, &RamdiskSize);
+    if (EFI_ERROR (Status)) { goto Fail; }
+    if (!RamdiskLayout (PayloadRamdisk, RamdiskSize, &RamdiskExpandedSize, &RamdiskPacked)) {
+      Print (L"DARWINBOOT: payload ramdisk layout rejected, %lu bytes\n", (UINT64)RamdiskSize);
+      Status = EFI_BAD_BUFFER_SIZE;
+      goto Fail;
+    }
+    Ramdisk = PayloadRamdisk;
+    Print (L"DARWINBOOT: ramdisk beside the kernel, %lu bytes (%lu expanded)\n", (UINT64)RamdiskSize, (UINT64)RamdiskExpandedSize);
+  }
   if (KeepPacked && (!RamdiskPacked || (RamdiskOffset == MAX_UINTN))) { Status = EFI_COMPROMISED_DATA; goto Fail; }
